# Environment file template — copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored (secrets). Never commit it.
# Sourced by: docker-compose (mongodb/librechat/caddy via env_file or ${VAR} interpolation),
# shell scripts (`source .env`), and the monitoring stack.

# --- network identity ---
# Single source for this box's LAN address (used by docs and any config needing it).
FLINT_LAN_IP=192.168.x.x

# --- Cloudflare (Caddy HTTPS, DNS-01 certificate for chat.testerlab.online) ---
# API token, scope: Edit zone DNS for the domain only.
CF_API_TOKEN=

# --- Open Web UI ---
# Secret for the web UI session encryption.
WEBUI_SECRET_KEY=
# OpenAI key sent to the backend (litellm does not check it — any value works).
OPENAI_API_KEY=

# --- LiteLLM / LibreChat secrets ---
# LibreChat MongoDB.
DB_PASS=
MONGO_URI=mongodb://mongodb:27017
# LibreChat app secrets (encryption + JWT). Generate strong random values.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
# LibreChat auth/social toggles.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ENDPOINTS=

# --- Telegram bot ---
TG_TOKEN=

# --- Search / tool API keys (agents + web UIs) ---
SERPER_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
JINA_API_URL=

# --- Maps / location ---
GOOGLE_MAPS_API_KEY=
ONEMAP_TOKEN=

# --- Grafana ---
# Service-account key for dashboard provisioning.
GRAFANA_SA_KEY=

# --- Ollama (legacy) ---
OLLAMA_BASE_URL=

# --- vLLM (legacy — not used; main model is SGLang) ---
VLLM_MODEL=
VLLM_MODEL_ALIAS=
VLLM_GPU_MEM_UTIL=
VLLM_MAX_LEN=
